#!/usr/bin/env python3
"""Nexa Hub desktop launcher and appearance manager. Runs natively on KDE Plasma 6."""
import shutil
import subprocess
import sys
from pathlib import Path
from PyQt6.QtCore import Qt
from PyQt6.QtWidgets import (QApplication, QFileDialog, QFrame, QGridLayout,
    QHBoxLayout, QLabel, QMainWindow, QMessageBox, QPushButton, QScrollArea,
    QVBoxLayout, QWidget, QLineEdit)
from PyQt6.QtGui import QIcon

BG = Path('/usr/share/backgrounds/nexa')

# (category, name, text, executable, icon name)
PROGRAMS = [
 ('Internet','Firefox', 'Real browser with extensions', 'firefox-esr', 'internet-web-browser'),
 ('Internet','Mail', 'Thunderbird email', 'thunderbird', 'internet-mail'),
 ('Internet','Remote desktop', 'Remmina remote desktop', 'remmina', 'preferences-desktop-remote-desktop'),
 ('Internet','Downloads', 'Transmission torrent client', 'transmission-qt', 'folder-download'),
 ('Documents','Files', 'Dolphin file manager', 'dolphin', 'system-file-manager'),
 ('Documents','PDF & e-books', 'Okular document reader', 'okular', 'application-pdf'),
 ('Documents','Office', 'LibreOffice suite', 'libreoffice', 'x-office-document'),

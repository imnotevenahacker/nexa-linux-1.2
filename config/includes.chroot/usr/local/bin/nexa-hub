 ('Media','Photos', 'Gwenview image viewer', 'gwenview', 'image-x-generic'),
 ('Media','Video', 'VLC video player', 'vlc', 'video-x-generic'),
 ('Media','Painting', 'Krita digital studio', 'krita', 'applications-graphics'),
 ('Media','Drawing', 'GIMP image editor', 'gimp', 'applications-graphics'),
 ('Media','Recording', 'OBS Studio screen recorder', 'obs', 'camera-video'),
 ('Utilities','Terminal', 'Real Linux shell', 'konsole', 'utilities-terminal'),
 ('Utilities','Calculator', 'KCalc', 'kcalc', 'accessories-calculator'),
 ('Utilities','Screenshot', 'Spectacle screenshots', 'spectacle', 'camera-photo'),
 ('Utilities','Software store', 'Discover apps and updates', 'plasma-discover', 'system-software-install'),
 ('Utilities','System monitor', 'CPU, memory and processes', 'plasma-systemmonitor', 'utilities-system-monitor'),
 ('Utilities','Settings', 'Full desktop personalization', 'systemsettings', 'preferences-system'),
 ('Utilities','Bluetooth', 'Bluetooth device setup', 'bluedevil-wizard', 'bluetooth'),
 ('Utilities','Phone connect', 'KDE Connect', 'kdeconnect-app', 'phone'),
 ('Games','Mines', 'Minesweeper classic', 'kmines', 'applications-games'),
 ('Games','Solitaire', 'KPat solitaire', 'kpat', 'applications-games'),
 ('Games','Sudoku', 'KSudoku puzzles', 'ksudoku', 'applications-games'),
 ('Games','Mahjongg', 'Tile matching', 'kmahjongg', 'applications-games'),
 ('Games','Platformer', 'SuperTux', 'supertux2', 'applications-games'),
